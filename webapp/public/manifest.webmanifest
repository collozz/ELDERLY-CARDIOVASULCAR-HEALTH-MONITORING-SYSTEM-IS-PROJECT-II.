{
  "name": "Elderly Heart Monitor",
  "short_name": "Heart Monitor",
  "description": "Heart rate monitoring and emergency alerts for elderly patients",
  "id": "/",
  "start_url": "/login.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f1b3d",
  "theme_color": "#0f1b3d",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Alerts", "url": "/alerts.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My Health", "url": "/my-health.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
