{
  "version": 1,
  "author": "Gitonga Cyrus Collins",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 140,
      "left": 190,
      "attrs": { "color": "green", "label": "Abnormal episode" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 30,
      "left": 210,
      "attrs": { "color": "red", "label": "Alert" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 90,
      "left": 160,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "btn1:1.l", "esp:4", "green", [ "h0" ] ],
    [ "btn1:2.l", "esp:GND.2", "black", [ "h0" ] ],
    [ "esp:2", "r1:2", "red", [ "h0" ] ],
    [ "r1:1", "led1:A", "red", [ "v0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
